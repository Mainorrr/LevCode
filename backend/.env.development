# Backend Environment Variables (Development)
PORT=3000
NODE_ENV=development

# Security
API_PASSWORD=levcode123

# Docker Java Execution
DOCKER_IMAGE=levcode-java:latest
JAVA_TIMEOUT=5000
JAVA_MEMORY=128m
JAVA_OUTPUT_MAX=10485760

# Database (local: postgres corriendo en localhost; docker-compose usa el servicio postgres)
DATABASE_URL=postgresql://levcode:levcode@localhost:5432/levcode

# CORS - Frontend en Vite puerto 5173 (was 3000 - FIXED)
FRONTEND_URL=http://localhost:3001
