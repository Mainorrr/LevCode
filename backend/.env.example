# Backend Environment Variables
PORT=3000
NODE_ENV=development

# Security - Change this password in production!
API_PASSWORD=your_secure_password_here

# Docker Python Execution
DOCKER_IMAGE=levcode-python:latest
PYTHON_TIMEOUT=5000
PYTHON_MEMORY=128m
PYTHON_OUTPUT_MAX=10485760

# Database (placeholder for future)
DATABASE_URL=postgresql://localhost:5432/levcode

# CORS
FRONTEND_URL=http://localhost:3000
