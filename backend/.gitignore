# Backend .gitignore

# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment files
.env
.env.*
.env.production
.env.development

# Build output
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# IDE and Editor
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.vim/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
*.pdb

# Testing
coverage/
.nyc_output/
*.lcov

# Temp files
tmp/
temp/
*.tmp

# Database
*.db
*.sqlite
*.sqlite3

# Runtime
.cache/
pid/
pid.lock
